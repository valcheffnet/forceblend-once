{
  "schemaVersion": 1,
  "id": "forceblendonce",
  "version": "${version}",
  "name": "ForceBlend Once",
  "description": "Prepares existing Overworld chunks for Minecraft's native terrain blending, once per world, with a backup first. Works in singleplayer and on dedicated servers. Fork of ForceBlend by mauro0805 with Minecraft 26.3 support.",
  "authors": [
    "mauro0805",
    "SasnycoN"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "client": [
      "com.mauro0805.forceblend.client.ForceBlendClient"
    ],
    "server": [
      "com.mauro0805.forceblend.server.ForceBlendServer"
    ]
  },
  "mixins": [
    {
      "config": "forceblend.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.12.12",
    "minecraft": [
      ">=1.18 <=1.21.11",
      ">=26.1 <=26.3"
    ],
    "java": ">=17"
  }
}
